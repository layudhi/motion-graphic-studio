[
  {
    "text": "Tahukah kamu?",
    "startMs": 0,
    "endMs": 1340
  },
  {
    "text": "Tumpukan batu bara raksasa\ndi tambang bisa terbakar hebat...",
    "startMs": 2210,
    "endMs": 5580
  },
  {
    "text": "tanpa pernah disulut korek api\nsedikit pun!",
    "startMs": 5770,
    "endMs": 8640
  },
  {
    "text": "Sebagai ahli tambang,\nkami menyebutnya swabakar",
    "startMs": 9210,
    "endMs": 12210
  },
  {
    "text": "atau spontaneous combustion.",
    "startMs": 12240,
    "endMs": 14100
  },
  {
    "text": "Saat terpapar udara, batu bara\nbereaksi dengan oksigen",
    "startMs": 14670,
    "endMs": 17670
  },
  {
    "text": "dan menghasilkan panas\nsecara alami.",
    "startMs": 17700,
    "endMs": 20140
  },
  {
    "text": "Masalahnya, jika tumpukan\nterlalu tinggi",
    "startMs": 20890,
    "endMs": 23510
  },
  {
    "text": "dan sirkulasi udara buruk,\npanas ini gagal keluar",
    "startMs": 23540,
    "endMs": 26710
  },
  {
    "text": "dan terus menumpuk di dalam.",
    "startMs": 26740,
    "endMs": 28420
  },
  {
    "text": "Begitu mencapai titik kritis...",
    "startMs": 28830,
    "endMs": 30060
  },
  {
    "text": "Boom! Api!",
    "startMs": 30574,
    "endMs": 31850
  },
  {
    "text": "Itulah mengapa di dunia tambang,",
    "startMs": 32870,
    "endMs": 34330
  },
  {
    "text": "manajemen tinggi timbunan\ndan pemadatan rutin",
    "startMs": 34360,
    "endMs": 36770
  },
  {
    "text": "wajib dilakukan untuk\nmencegah bencana.",
    "startMs": 36800,
    "endMs": 38960
  },
  {
    "text": "Sekarang kamu tahu, kan?",
    "startMs": 39690,
    "endMs": 41120
  }
]
